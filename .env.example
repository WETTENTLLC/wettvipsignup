# Environment variables for WETT VIP Portal Backend
# Copy this to .env and fill in your actual values

# Server
PORT=5000
NODE_ENV=development

# Twilio (for SMS)
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Database (if using external DB)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wett_vip
DB_USER=admin
DB_PASSWORD=your_password_here

# Optional: Analytics services
GOOGLE_ANALYTICS_ID=UA-XXXXX-X
MIXPANEL_TOKEN=your_token_here

# Optional: Payment processing (for future premium features)
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx

# CORS settings
CORS_ORIGIN=https://wett.vip
